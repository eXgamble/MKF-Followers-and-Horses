{
  // MKF - Followers and Horses: hold the Modifier Key Framework key to open a follower's or your
  // own horse's inventory. Activating normally stays vanilla (Talk / Ride).
  // Since Modifier Key Framework 1.6.0 every matching rule's modifier actions are shown together, so the
  // rules keep apart on their own: a follower who is down (unconscious: Death Timer's Give Potion / Search)
  // gets none of these. A follower's Inventory needs you and the follower out of combat, their potions go by
  // the follower's own fight. A horse goes by your fight (fleeing lasts while you fight): Inventory while you're
  // out of combat, Command: Flee (or Fight for a fleeing one) while you're in it.
  // Labels: Interface/Translations/MKF - Followers and Horses_<LANGUAGE>.txt
  "version": 8,
  "rules": [
    {
      "id": "followers",
      "target": "npc",
      "requires": { "teammate": true, "alive": true },
      "not": { "inCombat": true, "playerInCombat": true, "unconscious": true },
      "primary":   { "label": "$MKFFH_Talk" },
      "alternate": { "label": "$MKFFH_Inventory", "event": "MKFFH_OpenInventory" },
      "priority": 10
    },
    {
      // the follower in combat: your cheapest healing potion, or (modifier key) your cheapest magicka or
      // stamina potion, whichever they need most; one event, the alternate flag tells them apart
      // (downed followers are Death Timer's: unconscious ones are left out)
      "id": "followers-combat",
      "target": "npc",
      "requires": { "teammate": true, "alive": true, "inCombat": true },
      "not": { "unconscious": true },
      "primary":   { "label": "$MKFFH_GivePotion",        "event": "MKFFH_GivePotion" },
      "alternate": { "label": "$MKFFH_GiveRestorePotion", "event": "MKFFH_GivePotion" },
      "priority": 10
    },
    {
      "id": "horses",
      "target": "npc",
      "requires": {
        "keyword": "Skyrim.esm|0x26110",  // ActorTypeHorse (on the race: also covers modded mounts)
        "faction": "Skyrim.esm|0x68D78",  // PlayerHorseFaction: horses you own
        "alive": true
      },
      "not": { "playerInCombat": true },
      "primary":   { "label": "$MKFFH_Ride" },
      "alternate": { "label": "$MKFFH_Inventory", "event": "MKFFH_OpenInventory" },
      "priority": 10
    },
    {
      // you in combat: Command: Flee makes your horse cowardly until Fight or the end of your fight
      "id": "horses-combat",
      "target": "npc",
      "requires": {
        "keyword": "Skyrim.esm|0x26110",
        "faction": "Skyrim.esm|0x68D78",
        "alive": true,
        "playerInCombat": true
      },
      "not": { "faction": "MKF - Followers and Horses.esp|0x802" },  // already fleeing: horses-fleeing's Command: Fight
      "primary":   { "label": "$MKFFH_Ride" },
      "alternate": { "label": "$MKFFH_CommandFlee", "event": "MKFFH_HorseCommand" },
      "priority": 10
    },
    {
      // a fleeing horse while you're in combat (MKFFH_FleeingFaction, only ever on your own horses): Command: Fight
      "id": "horses-fleeing",
      "target": "npc",
      "requires": {
        "keyword": "Skyrim.esm|0x26110",
        "faction": "MKF - Followers and Horses.esp|0x802",
        "alive": true,
        "playerInCombat": true
      },
      "primary":   { "label": "$MKFFH_Ride" },
      "alternate": { "label": "$MKFFH_CommandFight", "event": "MKFFH_HorseCommand" },
      "priority": 11
    }
  ]
}
